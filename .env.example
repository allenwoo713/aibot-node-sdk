# ================================================
# Required: WeCom Bot Credentials
# ================================================
# Bot ID from WeCom admin console (智能机器人 -> 机器人 ID)
BOT_ID=your-bot-id

# Bot Secret from WeCom admin console (智能机器人 -> Secret)
SECRET=your-bot-secret

# ================================================
# Required: Anthropic-compatible API
# ================================================
# Get from https://console.anthropic.com/settings/keys (or your compatible provider)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: Base URL for Anthropic-compatible APIs (e.g. ModelScope, OpenRouter, etc.)
# ANTHROPIC_BASE_URL=https://api-inference.modelscope.cn/v1

# ================================================
# Optional: Anthropic Model
# ================================================
# Default: claude-3-5-sonnet-20241022
# Other options: claude-3-opus-20240229, claude-3-5-haiku-20241022
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ================================================
# Optional: WeCom HTTP API Credentials
# ================================================
# CORP_ID defaults to BOT_ID if not provided
# AGENT_ID defaults to BOT_ID if not provided
# Required only if you use HTTP fallback transport
# CORP_ID=wwxxxxxxxxxxxxxxxx
# AGENT_ID=your-agent-id

# ================================================
# Optional: WeCom WebSocket URL
# ================================================
# Default: wss://openws.work.weixin.qq.com
# For private deployment, use your custom WS URL from admin console
# WS_URL=wss://openws.work.weixin.qq.com

# ================================================
# Optional: Conversation & Memory Settings
# ================================================
# How long before a conversation expires (default: 30 min)
# CONVERSATION_TTL_MS=1800000

# Max concurrent conversations in memory (default: 1000)
# MAX_CONVERSATIONS=1000

# Max messages per conversation history (default: 20)
# MAX_HISTORY_MESSAGES=20

# File path for persisting conversation state (default: ./.bot-state.json)
# PERSISTENCE_PATH=./.bot-state.json

# ================================================
# Optional: Rate Limiting
# ================================================
# Max requests per conversation per window (default: 10)
# RATE_LIMIT_REQUESTS=10

# Rate limit window in ms (default: 60 sec)
# RATE_LIMIT_WINDOW_MS=60000

# ================================================
# Optional: API Timeout & Output Limits
# ================================================
# Anthropic API timeout in ms (default: 30 sec)
# API_TIMEOUT_MS=30000

# Max output tokens per response (default: 2048)
# MAX_OUTPUT_TOKENS=2048

# ================================================
# Optional: AI Retry & Cost Guard Settings
# ================================================
# Max input tokens before truncating conversation history (default: 8192)
# MAX_INPUT_TOKENS=8192

# Max retries for retryable AI API errors — 429, 5xx, timeout (default: 1)
# MAX_RETRIES=1

# Base delay in ms before the first retry (default: 2000)
# RETRY_BASE_DELAY_MS=2000

# Backoff multiplier between retries (default: 2)
# RETRY_BACKOFF_MULTIPLIER=2

# Add random jitter to retry delays to avoid thundering herd (default: true)
# RETRY_JITTER=true

# Fallback messages per error type (shown to end users)
# FALLBACK_RATE_LIMIT=请求过于频繁，请稍后再试。
# FALLBACK_AUTH_INVALID=AI 服务认证失败，请联系管理员。
# FALLBACK_VALIDATION_FAILED=AI 返回了无效响应，请重试。
# FALLBACK_RETRYABLE=服务暂时繁忙，请稍后再试。

# ================================================
# Optional: System Prompts
# ================================================
# Prompt used for internal employees
# INTERNAL_SYSTEM_PROMPT=You are a helpful AI assistant for our company employees. You can answer questions about internal processes, draft emails, and help with code.

# Prompt used for external contacts
# EXTERNAL_SYSTEM_PROMPT=You are a helpful AI assistant for external visitors. Do not discuss internal company data, pricing, or confidential information. Keep replies concise and professional.

# ================================================
# Optional: Contact Classification
# ================================================
# Your own WeCom corp ID. Used to detect external contacts by comparing sender corpid.
# OWN_CORP_ID=wwxxxxxxxxxxxxxxxx
